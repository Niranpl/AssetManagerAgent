
<Window x:Class="AssetManagerAgent.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asset Manager Agent Installer"
        Height="540" Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F6FA">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#163B32"
                CornerRadius="14"
                Padding="22">
            <StackPanel>
                <TextBlock Text="ASSET MANAGER"
                           Foreground="#A7E3C6"
                           FontSize="12"
                           FontWeight="Bold"/>
                <TextBlock Text="Install Inventory Agent"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Margin="0,8,0,5"/>
                <TextBlock Text="Select your company vendor before installing."
                           Foreground="#D8E8E2"
                           FontSize="14"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,24,0,12">
            <TextBlock Text="Vendor selection"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#20312D"/>
            <TextBlock Text="Only active vendors are available for installation."
                       Margin="0,5,0,0"
                       Foreground="#64736F"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DCE5E1"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22">
            <StackPanel>
                <TextBlock Text="Company / Vendor"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <ComboBox x:Name="VendorCombo"
                          Height="42"
                          FontSize="14"
                          Padding="8"
                          IsEnabled="False"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="VendorCombo_SelectionChanged"/>

                <Button x:Name="LoadVendorsButton"
                        Content="Load Vendors"
                        Height="40"
                        Margin="0,12,0,0"
                        Background="#E4F3EC"
                        Foreground="#163B32"
                        FontWeight="SemiBold"
                        Click="LoadVendorsButton_Click"/>

                <TextBlock Text="Installation location"
                           FontWeight="SemiBold"
                           Margin="0,24,0,6"/>

                <TextBlock Text="C:\Program Files\AHTAgent"
                           Foreground="#52635D"
                           FontSize="14"/>

                <TextBlock x:Name="StatusText"
                           Text="Load the vendor list to continue."
                           TextWrapping="Wrap"
                           Foreground="#64736F"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="AHT Asset Manager"
                       VerticalAlignment="Center"
                       Foreground="#788780"/>
            <Button x:Name="InstallButton"
                    DockPanel.Dock="Right"
                    Content="Install Agent"
                    Width="160"
                    Height="44"
                    Background="#176B50"
                    Foreground="White"
                    FontWeight="Bold"
                    IsEnabled="False"
                    Click="InstallButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
